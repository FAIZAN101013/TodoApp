# Copy this file to a new file named ".env" and fill in your own values.

# Your MongoDB Atlas connection string
# (Atlas dashboard -> Connect -> Drivers -> copy the string, put your password in it)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/todoapp

# Any long random text - used to sign login tokens
JWT_SECRET=change-this-to-any-long-random-text

# Port the server listens on
PORT=5000
